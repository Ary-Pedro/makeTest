{
  "name": "automation-exercise-cypress",
  "version": "1.0.0",
  "private": true,
  "description": "Suite Cypress E2E para os fluxos do Automation Exercise.",
  "type": "module",
  "scripts": {
    "cypress:open": "env -u ELECTRON_RUN_AS_NODE cypress open",
    "cypress:run": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "cypress:run:automation": "env -u ELECTRON_RUN_AS_NODE cypress run --spec cypress/e2e/automation-exercise.cy.js",
    "cypress:verify": "env -u ELECTRON_RUN_AS_NODE cypress verify",
    "cy:open": "npm run cypress:open",
    "cy:run": "npm run cypress:run",
    "cy:verify": "npm run cypress:verify",
    "test": "npm run cypress:run"
  },
  "devDependencies": {
    "cypress": "^15.14.2"
  }
}
